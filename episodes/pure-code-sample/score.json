{
  "version": 1,
  "fps": 24,
  "key": "F major",
  "instruments": {
    "piano_felt": {
      "name": "毡锤钢琴",
      "range": ["F3", "F6"],
      "notes": "琴槌垫毡，起音软、高频少；乐句内踩延音踏板，乐句结束抬起"
    },
    "strings_pad": {
      "name": "弦乐长音",
      "range": ["F2", "A5"],
      "notes": "加弱音器的小弦乐组，每个声部 4 名演奏者，音高和揉弦各自轻微漂移；只拉长音，音量由 expression 控制"
    },
    "harp": {
      "name": "竖琴",
      "range": ["C2", "G6"],
      "notes": "拨弦，自然衰减；gliss 是按 F 大调音阶的快速刮奏"
    },
    "glockenspiel": {
      "name": "钟琴",
      "range": ["F5", "C8"],
      "notes": "软槌，余音长，只在光到时点两下"
    }
  },
  "sections": [
    {
      "id": "rain",
      "name": "雨停",
      "from": {
        "shot": "S1",
        "frame": 0
      },
      "notes": "没有配乐，只有雨的尾声和滴水"
    },
    {
      "id": "light",
      "name": "光来",
      "from": {
        "event": "light_break"
      },
      "notes": "动机的头两个音，弦乐从极弱进来；在 drip_fall 之前完全退掉，给最后一滴让位"
    },
    {
      "id": "shake",
      "name": "抖水",
      "from": {
        "event": "puff"
      },
      "notes": "抖水时不配乐，蓬起时竖琴拨一下，之后不再出新音，让余音自然响完，直到看光"
    },
    {
      "id": "look",
      "name": "看光",
      "from": {
        "event": "look_up"
      },
      "notes": "动机再出现，弦乐转到下属和弦，温暖"
    },
    {
      "id": "crouch",
      "name": "压身",
      "from": {
        "event": "crouch"
      },
      "notes": "属和弦垫在起飞之前"
    },
    {
      "id": "flight",
      "name": "起飞",
      "from": {
        "event": "takeoff"
      },
      "notes": "竖琴上行刮奏、弦乐上扬，钢琴把动机往上走完；最后一个音留在空竹竿上"
    }
  ],
