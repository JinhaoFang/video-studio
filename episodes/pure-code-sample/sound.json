{
  "version": 1,
  "notes": "音效设计数据，#158 的混音器按它放音效。每个音效合成时按参考电平归一（最响的 100 ms 为 -18 LUFS，峰值不超过 -1.5 dBFS），再按 db 放到片中；db 必须落在 tier 的范围内。对齐点是音效里必须落在事件帧上的时刻，合成时返回它距第一个采样的秒数。锚点写法和 score.json 相同；eventMap 的值为空数组表示故意不出声。pan 为 -1（左）到 1（右）。",
  "tiers": {
    "hero": {
      "name": "主",
      "range": [-8, 0]
    },
    "foley": {
      "name": "拟音",
      "range": [-22, -10]
    },
    "ambience": {
      "name": "环境",
      "range": [-34, -22]
    }
  },
  "scenes": {
    "eaves": {
      "name": "檐下近场",
