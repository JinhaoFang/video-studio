{
  "version": 1,
  "fps": 24,
  "key": "F major",
  "instruments": {
    "piano_felt": {
      "name": "毡锤钢琴",
      "range": [
        "F3",
        "F6"
      ],
      "notes": "琴槌垫毡，起音软、高频少；乐句内踩延音踏板，乐句结束抬起"
    },
    "strings_pad": {
      "name": "弦乐长音",
      "range": [
        "F2",
        "A5"
      ],
      "notes": "加弱音器的小弦乐组，每个声部 4 名演奏者，音高和揉弦各自轻微漂移；只拉长音，音量由 expression 控制"
    },
    "harp": {
      "name": "竖琴",
      "range": [
        "C2",
        "G6"
      ],
      "notes": "拨弦，自然衰减；gliss 是按 F 大调音阶的快速刮奏"
    },
    "glockenspiel": {
      "name": "钟琴",
      "range": [
        "F5",
        "C8"
      ],
      "notes": "软槌，余音长；只在光到（第 3 镜）和落进同伴中间（第 11 镜）各点两下，两处同样的 F6、C7"
    },
    "hum_voice": {
      "name": "哼唱（剧中人声）",
      "range": [
        "G3",
        "D4"
      ],
      "notes": "那个人边走边哼：闭口的 m 音为主，乐句开头偶尔开口带一点 n；音与音之间有轻微滑音；音准有 ±10 音分的自然起伏，时值有 ±1–2 帧的松紧；中音区，听不出是男是女。由 #184 的纯代码人声合成（kit 的 Instrument 目前只有四件乐器，由 #184 决定怎么接进来）"
    }
  },
  "sections": [
    {
      "id": "storm",
      "name": "雷雨",
      "from": {
        "event": "open"
      },
      "notes": "没有配乐，只有雷雨、檐下流水和屋里模糊的说话"
    },
    {
      "id": "light",
      "name": "光来",
      "from": {
        "event": "light_break"
      },
      "notes": "小样原样：动机的头两个音，弦乐从极弱进来；最后一滴之前完全退掉"
    },
    {
      "id": "fall",
      "name": "起飞失败",
      "from": {
        "event": "fall_back"
      },
      "notes": "只在掉回竹竿时竖琴拨一下，其余交给拟音和停顿"
    },
    {
      "id": "hum",
      "name": "哼唱",
      "from": {
        "event": "hum_start"
      },
      "notes": "剧中的哼唱，不配乐"
    },
    {
      "id": "shake",
      "name": "甩水与晒太阳",
      "from": {
        "event": "puff"
      },
      "notes": "小样原样：蓬起时竖琴拨一下；之后不出新音，余音自然收完，一直到看光（整个第 8 镜是静默）"
    },
    {
      "id": "look",
      "name": "看光",
      "from": {
        "event": "look_up"
      },
      "notes": "小样原样：动机再出一次，弦乐转到 B♭"
    },
    {
      "id": "crouch",
      "name": "压身",
      "from": {
        "event": "crouch"
      },
      "notes": "小样原样：弦乐转到 C，渐强"
    },
    {
      "id": "flight",
      "name": "起飞",
      "from": {
        "event": "takeoff"
      },
      "notes": "小样原样：竖琴上行刮奏，弦乐回到 F，钢琴往上走 F–A–C–D，接进主旋律"
    },
    {
      "id": "theme",
      "name": "飞过稻田",
      "from": {
        "event": "land",
        "offsetFrames": -139
      },
      "notes": "主旋律第一次完整奏出，3/4 拍，F | B♭ C | Dm | B♭ C"
    },
    {
      "id": "dusk",
      "name": "暮色",
      "from": {
        "event": "lamp_on"
      },
      "notes": "最后一个和弦，F；之后不出新音"
    }
  ],
