      "pauseAfterSeconds": 0.24,
      "startFrame": 46,
      "endFrame": 109,
      "audioDurationSeconds": 2.1,
      "audioSrc": "episodes/nasa-punk-opening/voiceover-rubberband-v2/L002.mp3"
    },
    {
      "id": "L003",
