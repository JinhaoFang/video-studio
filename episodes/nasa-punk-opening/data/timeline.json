  "lines": [
    {
      "id": "L001",
      "text": "2020年5月",
      "pauseAfterSeconds": 0.08,
      "startFrame": 11,
      "endFrame": 52,
      "audioDurationSeconds": 1.36,
      "audioSrc": "episodes/nasa-punk-opening/voiceover/L001.mp3"
    },
    {
      "id": "L002",
      "text": "一枚火箭在夜里推出厂房",
      "pauseAfterSeconds": 0.24,
      "startFrame": 54,
      "endFrame": 134,
      "audioDurationSeconds": 2.64,
      "audioSrc": "episodes/nasa-punk-opening/voiceover/L002.mp3"
    },
    {
      "id": "L003",
      "text": "箭体上印着一个红色的标志",
      "pauseAfterSeconds": 0.84,
      "startFrame": 141,
      "endFrame": 222,
      "audioDurationSeconds": 2.72,
      "audioSrc": "episodes/nasa-punk-opening/voiceover/L003.mp3"
    },
    {
      "id": "L004",
      "text": "这个标志",
      "pauseAfterSeconds": 0.1,
      "startFrame": 248,
      "endFrame": 274,
      "audioDurationSeconds": 0.88,
      "audioSrc": "episodes/nasa-punk-opening/voiceover/L004.mp3"
    },
    {
      "id": "L005",
      "text": "NASA自己废过一次",
      "pauseAfterSeconds": 0.7,
      "startFrame": 277,
      "endFrame": 378,
      "audioDurationSeconds": 3.36,
      "audioSrc": "episodes/nasa-punk-opening/voiceover/L005.mp3"
    },
    {
      "id": "L006",
      "text": "后来",
      "pauseAfterSeconds": 0.02,
      "startFrame": 399,
      "endFrame": 413,
      "audioDurationSeconds": 0.48,
      "audioSrc": "episodes/nasa-punk-opening/voiceover/L006.mp3"
    },
    {
      "id": "L007",
      "text": "它还长成了一种风格",
      "pauseAfterSeconds": 1.3,
      "startFrame": 414,
      "endFrame": 467,
      "audioDurationSeconds": 1.76,
      "audioSrc": "episodes/nasa-punk-opening/voiceover/L007.mp3"
    },
    {
      "id": "L008",
      "text": "时间往回倒",
      "pauseAfterSeconds": 0.2,
      "startFrame": 506,
      "endFrame": 549,
      "audioDurationSeconds": 1.44,
      "audioSrc": "episodes/nasa-punk-opening/voiceover/L008.mp3"
    },
    {
      "id": "L009",
      "text": "1974年",
      "pauseAfterSeconds": 0.08,
      "startFrame": 555,
      "endFrame": 588,
      "audioDurationSeconds": 1.12,
      "audioSrc": "episodes/nasa-punk-opening/voiceover/L009.mp3"
    },
    {
      "id": "L010",
      "text": "NASA用的还是一个蓝色的圆形徽章",
      "pauseAfterSeconds": 0.14,
      "startFrame": 591,
      "endFrame": 706,
      "audioDurationSeconds": 3.84,
      "audioSrc": "episodes/nasa-punk-opening/voiceover/L010.mp3"
    },
    {
      "id": "L011",
      "text": "大家管它叫肉丸",
      "pauseAfterSeconds": 0.7,
      "startFrame": 710,
      "endFrame": 758,
      "audioDurationSeconds": 1.6,
      "audioSrc": "episodes/nasa-punk-opening/voiceover/L011.mp3"
    },
    {
      "id": "L012",
      "text": "那一年",
      "pauseAfterSeconds": 0.1,
      "startFrame": 779,
      "endFrame": 801,
      "audioDurationSeconds": 0.72,
      "audioSrc": "episodes/nasa-punk-opening/voiceover/L012.mp3"
    },
    {
      "id": "L013",
      "text": "美国政府推动各个机构换新形象",
      "pauseAfterSeconds": 0.28,
      "startFrame": 804,
      "endFrame": 907,
      "audioDurationSeconds": 3.44,
      "audioSrc": "episodes/nasa-punk-opening/voiceover/L013.mp3"
    },
    {
      "id": "L014",
      "text": "纽约两个年轻设计师接下了NASA这一单",
      "pauseAfterSeconds": 0.56,
      "startFrame": 915,
      "endFrame": 1043,
      "audioDurationSeconds": 4.24,
      "audioSrc": "episodes/nasa-punk-opening/voiceover/L014.mp3"
    },
    {
      "id": "L015",
      "text": "他们把四个字母削到最简",
      "pauseAfterSeconds": 0,
      "startFrame": 1059,
      "endFrame": 1136,
      "audioDurationSeconds": 2.56,
      "audioSrc": "episodes/nasa-punk-opening/voiceover/L015.mp3"
    },
    {
      "id": "L016",
      "text": "笔画一样粗　连成一条",
      "pauseAfterSeconds": 0.44,
      "startFrame": 1136,
      "endFrame": 1208,
      "audioDurationSeconds": 2.4,
      "audioSrc": "episodes/nasa-punk-opening/voiceover/L016.mp3"
    },
    {
      "id": "L017",
      "text": "两个A干脆去掉了横杠",
      "pauseAfterSeconds": 0.56,
      "startFrame": 1221,
      "endFrame": 1291,
      "audioDurationSeconds": 2.32,
      "audioSrc": "episodes/nasa-punk-opening/voiceover/L017.mp3"
    },
    {
      "id": "L018",
      "text": "手册里写着",
      "pauseAfterSeconds": 0,
      "startFrame": 1308,
      "endFrame": 1349,
      "audioDurationSeconds": 1.36,
      "audioSrc": "episodes/nasa-punk-opening/voiceover/L018.mp3"
    },
    {
      "id": "L019",
      "text": "这样　字标就有了一股向上的推力",
      "pauseAfterSeconds": 0.54,
      "startFrame": 1349,
      "endFrame": 1452,
      "audioDurationSeconds": 3.44,
      "audioSrc": "episodes/nasa-punk-opening/voiceover/L019.mp3"
    },
    {
      "id": "L020",
      "text": "像两枚等着发射的火箭",
      "pauseAfterSeconds": 0.7,
      "startFrame": 1468,
      "endFrame": 1542,
      "audioDurationSeconds": 2.48,
      "audioSrc": "episodes/nasa-punk-opening/voiceover/L020.mp3"
    },
    {
      "id": "L021",
      "text": "笔画弯弯曲曲连成一条",
      "pauseAfterSeconds": 0,
      "startFrame": 1563,
      "endFrame": 1652,
      "audioDurationSeconds": 2.96,
      "audioSrc": "episodes/nasa-punk-opening/voiceover/L021.mp3"
    },
    {
      "id": "L022",
      "text": "后来大家叫它蠕虫",
