      "pauseAfterSeconds": 0.84,
      "startFrame": 116,
      "endFrame": 183,
      "audioDurationSeconds": 2.2272789115646257,
      "audioSrc": "episodes/nasa-punk-opening/voiceover-rubberband-v2/L003.mp3"
    },
    {
      "id": "L004",
      "text": "这个标志",
      "pauseAfterSeconds": 0.1,
      "startFrame": 208,
      "endFrame": 233,
      "audioDurationSeconds": 0.8272789115646259,
      "audioSrc": "episodes/nasa-punk-opening/voiceover-rubberband-v2/L004.mp3"
    },
    {
      "id": "L005",
      "text": "NASA自己废过一次",
      "pauseAfterSeconds": 0.7,
      "startFrame": 236,
      "endFrame": 286,
      "audioDurationSeconds": 1.6545351473922902,
      "audioSrc": "episodes/nasa-punk-opening/voiceover-rubberband-v2/L005.mp3"
    },
    {
      "id": "L006",
      "text": "后来",
      "pauseAfterSeconds": 0.02,
      "startFrame": 307,
      "endFrame": 330,
      "audioDurationSeconds": 0.7636281179138322,
      "audioSrc": "episodes/nasa-punk-opening/voiceover-rubberband-v2/L006.mp3"
    },
    {
      "id": "L007",
      "text": "它还长成了一种风格",
      "pauseAfterSeconds": 1.3,
      "startFrame": 330,
      "endFrame": 374,
      "audioDurationSeconds": 1.463922902494331,
      "audioSrc": "episodes/nasa-punk-opening/voiceover-rubberband-v2/L007.mp3"
    },
    {
      "id": "L008",
      "text": "时间往回倒",
      "pauseAfterSeconds": 0.2,
      "startFrame": 413,
      "endFrame": 453,
      "audioDurationSeconds": 1.3217460317460317,
      "audioSrc": "episodes/nasa-punk-opening/voiceover-rubberband-v2/L008.mp3"
    },
    {
      "id": "L009",
      "text": "1974年",
      "pauseAfterSeconds": 0.08,
      "startFrame": 459,
      "endFrame": 489,
      "audioDurationSeconds": 1.0181859410430838,
      "audioSrc": "episodes/nasa-punk-opening/voiceover-rubberband-v2/L009.mp3"
    },
    {
      "id": "L010",
      "text": "NASA用的还是一个蓝色的圆形徽章",
      "pauseAfterSeconds": 0.14,
      "startFrame": 492,
      "endFrame": 570,
      "audioDurationSeconds": 2.6090929705215418,
      "audioSrc": "episodes/nasa-punk-opening/voiceover-rubberband-v2/L010.mp3"
    },
    {
      "id": "L011",
      "text": "大家管它叫肉丸",
      "pauseAfterSeconds": 0.7,
      "startFrame": 574,
      "endFrame": 614,
      "audioDurationSeconds": 1.3363718820861679,
      "audioSrc": "episodes/nasa-punk-opening/voiceover-rubberband-v2/L011.mp3"
    },
    {
      "id": "L012",
      "text": "那一年",
      "pauseAfterSeconds": 0.1,
      "startFrame": 635,
      "endFrame": 652,
      "audioDurationSeconds": 0.5727210884353742,
      "audioSrc": "episodes/nasa-punk-opening/voiceover-rubberband-v2/L012.mp3"
    },
    {
      "id": "L013",
      "text": "美国政府推动各个机构换新形象",
      "pauseAfterSeconds": 0.28,
      "startFrame": 655,
      "endFrame": 736,
      "audioDurationSeconds": 2.6727210884353743,
      "audioSrc": "episodes/nasa-punk-opening/voiceover-rubberband-v2/L013.mp3"
    },
    {
      "id": "L014",
      "text": "纽约两个年轻设计师接下了NASA这一单",
      "pauseAfterSeconds": 0.56,
      "startFrame": 744,
      "endFrame": 832,
      "audioDurationSeconds": 2.927278911564626,
      "audioSrc": "episodes/nasa-punk-opening/voiceover-rubberband-v2/L014.mp3"
    },
    {
      "id": "L015",
      "text": "他们把四个字母削到最简",
      "pauseAfterSeconds": 0,
      "startFrame": 849,
      "endFrame": 910,
      "audioDurationSeconds": 2.0363718820861676,
      "audioSrc": "episodes/nasa-punk-opening/voiceover-rubberband-v2/L015.mp3"
    },
    {
      "id": "L016",
      "text": "笔画一样粗　连成一条",
      "pauseAfterSeconds": 0.44,
      "startFrame": 910,
      "endFrame": 980,
      "audioDurationSeconds": 2.35453514739229,
      "audioSrc": "episodes/nasa-punk-opening/voiceover-rubberband-v2/L016.mp3"
    },
    {
      "id": "L017",
      "text": "两个A干脆去掉了横杠",
      "pauseAfterSeconds": 0.56,
      "startFrame": 994,
      "endFrame": 1047,
      "audioDurationSeconds": 1.781814058956916,
      "audioSrc": "episodes/nasa-punk-opening/voiceover-rubberband-v2/L017.mp3"
    },
    {
      "id": "L018",
      "text": "手册里写着",
      "pauseAfterSeconds": 0,
      "startFrame": 1064,
      "endFrame": 1096,
      "audioDurationSeconds": 1.081814058956916,
      "audioSrc": "episodes/nasa-punk-opening/voiceover-rubberband-v2/L018.mp3"
    },
    {
      "id": "L019",
      "text": "这样　字标就有了一股向上的推力",
      "pauseAfterSeconds": 0.54,
      "startFrame": 1096,
      "endFrame": 1182,
      "audioDurationSeconds": 2.8636281179138323,
      "audioSrc": "episodes/nasa-punk-opening/voiceover-rubberband-v2/L019.mp3"
    },
    {
      "id": "L020",
      "text": "像两枚等着发射的火箭",
      "pauseAfterSeconds": 0.7,
      "startFrame": 1198,
      "endFrame": 1259,
      "audioDurationSeconds": 2.0363718820861676,
      "audioSrc": "episodes/nasa-punk-opening/voiceover-rubberband-v2/L020.mp3"
    },
    {
      "id": "L021",
      "text": "笔画弯弯曲曲连成一条",
      "pauseAfterSeconds": 0,
      "startFrame": 1280,
      "endFrame": 1349,
      "audioDurationSeconds": 2.290907029478458,
      "audioSrc": "episodes/nasa-punk-opening/voiceover-rubberband-v2/L021.mp3"
    },
    {
      "id": "L022",
      "text": "后来大家叫它蠕虫",
      "pauseAfterSeconds": 1.34,
      "startFrame": 1349,
      "endFrame": 1397,
