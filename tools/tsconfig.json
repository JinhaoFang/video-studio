{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "./**/*.ts",
    "../src/kit/generation/**/*.ts",
    "../src/kit/sound/**/*.ts",
    "../src/**/*.test.ts",
    "../episodes/**/*.test.ts",
    "../episodes/after-rain/auditions/**/*.ts",
    "../episodes/after-rain/generate.ts",
    "../episodes/pure-code-sample/generate.ts",
    "../episodes/pure-code-sample/sound/**/*.ts",
    "../*.test.ts"
  ],
  "exclude": []
}
