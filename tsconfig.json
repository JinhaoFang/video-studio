{
  "compilerOptions": {
    "target": "ES2018",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["es2015"],
    "types": ["react", "web"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true
  },
  "include": ["src", "episodes"],
  "exclude": [
    "remotion.config.ts",
    "**/*.test.ts",
    "src/kit/generation",
    "src/kit/sound",
    "episodes/pure-code-sample/generate.ts",
    "episodes/pure-code-sample/audio.ts",
    "episodes/pure-code-sample/sound"
  ]
}
